# Every environment variable Plumb reads, in one place.
#
#   cp .env.example .env
#
# Copy it as-is and nothing changes: a blank value means "not set", so each
# variable keeps its documented default (see `src/env.ts`). Fill in only what
# you need. `.env` is gitignored.
#
# Nothing here is required to try Plumb. `npm run demo` runs the entire
# design→code→verify loop with none of these set, and the MCP server's plugin
# path (plumb_outline / plumb_node / plumb_selection / …) only needs the Figma
# plugin paired — not a token.
#
# NOTE: an MCP client (Claude Code, Cursor, Windsurf) spawns the server as a
# fresh process and passes through only the env it was given. Plumb reads this
# file at startup from the cwd and the package root, but the most reliable place
# for keys is your client's server `env` block.
#
# `src/env.test.ts` asserts this file stays in sync with every `process.env`
# reference in the source, so it cannot silently fall behind.


# ─── Figma REST path ──────────────────────────────────────────────────────────
# Only needed for the REST tools (plumb_fig_outline / plumb_fig_node) and the
# standalone `plumb-mcp verify` / `plumb-mcp fit` CLIs. The plugin path needs none.

# A read-only Figma personal access token. Create one at:
# figma.com → Settings → Security → personal access tokens (File content scope).
FIGMA_TOKEN=

# Alias for FIGMA_TOKEN, checked second. Useful when another Figma tool in the
# same environment already exports this name.
FIGMA_ACCESS_TOKEN=

# The string after /design/ in a Figma file URL. Used by `npm run prove` and as
# the default file for the CLIs.
PLUMB_FILE_KEY=

# The node to extract, using ':' not '-'. Default: 131:6950
PLUMB_NODE_ID=


# ─── Bridge (the local WebSocket server the Figma plugin pairs with) ──────────

# Pin the bridge to one port instead of scanning 31337-31346. Set this when you
# run more than ten concurrent sessions, or in a container that must publish a
# known port. Default: the 31337-31346 scan.
PLUMB_BRIDGE_PORT=

# Or an ordered pool to try, comma-separated (`31400,31401`). `0` means "any
# free port". Default: the same built-in pool.
PLUMB_BRIDGE_PORTS=

# Interface the bridge binds. Default: 127.0.0.1 - loopback only, which is the
# security posture the pairing model assumes. Override ONLY inside a container
# that maps the port back to the host; binding a routable interface exposes the
# pairing handshake to anyone who can reach the port.
PLUMB_BRIDGE_HOST=

# Label this session shows as in the plugin panel when several agents are
# paired at once. Default: the current directory name.
PLUMB_SESSION_NAME=

# The bridge also serves GET /healthz (and /health) plus GET /metrics - useful
# as a container healthcheck. Neither needs configuration.


# ─── Logging and terminal output ─────────────────────────────────────────────
# Logs always go to stderr; stdout carries the MCP JSON-RPC channel.

# debug | info | warn | error. Default: info
PLUMB_LOG_LEVEL=

# `json` emits one JSON object per line, for a log shipper.
# Default: human-readable lines.
PLUMB_LOG_FORMAT=

# Standard cross-tool conventions, honoured but never set by Plumb. Listed here
# because `plumb-mcp demo` reads both to decide whether to colour its report,
# and "which env vars does this project read?" should have one complete answer.

# Set to any value to disable ANSI colour. https://no-color.org
NO_COLOR=

# `dumb` also disables colour; otherwise untouched. Default: your terminal's.
TERM=


# ─── Where Plumb writes ───────────────────────────────────────────────────────

# Exported icons and images from plumb_assets. Default: ./plumb-assets
PLUMB_ASSETS_DIR=

# Rendered PNGs from plumb_screenshot. Default: ./plumb-screenshots
PLUMB_SCREENSHOTS_DIR=

# Response cache root. Default: ~/.cache/plumb
PLUMB_CACHE_DIR=

# Cache entry lifetime in milliseconds. Default: 300000 (5 minutes)
PLUMB_CACHE_TTL_MS=


# ─── Headless Chrome (plumb_verify, plumb_fit, plumb_import_web) ─────────────
# Plumb drives your installed Chrome over CDP - it never downloads a browser.
# Both names work; PLUMB_CHROME wins. Default: auto-detected from the standard
# install paths for your platform.

# e.g. /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PLUMB_CHROME=

# Alias for PLUMB_CHROME, checked second.
CHROME_PATH=


# ─── Standalone CLI only (`plumb-mcp fit`) ───────────────────────────────────
# The MCP tools use your editor's own model and need no key. The autonomous CLI
# generates code itself, so it brings its own.

# e.g. sk-ant-...
ANTHROPIC_API_KEY=

# Model the fit CLI generates with. Default: the built-in choice.
PLUMB_FIT_MODEL=


# ─── prompt→design asset providers (ALL FREE, no credit card) ────────────────
# Without at least one photo key, plumb_design falls back to RANDOM placeholder
# imagery (Lorem Picsum ignores the query). Set one for on-brief photography.

# https://unsplash.com/developers  (50 req/hr free)
UNSPLASH_ACCESS_KEY=

# https://www.pexels.com/api/  (200 req/hr free)
PEXELS_API_KEY=

# https://pixabay.com/api/docs/  (free)
PIXABAY_API_KEY=

# Unkeyed font search covers the popular Google Fonts subset; a key unlocks the
# full catalog. https://developers.google.com/fonts/docs/developer_api
GOOGLE_FONTS_API_KEY=
